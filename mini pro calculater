#calculator
a = float(input("enter 1st num: "))
b = float(input("enter 2nd num: "))
op = input("enter operator(=, +, -, *, ==, %, /, **): ")



if op == '+':
    print(a + b)
elif op == '-':
    print(a - b)
elif op == '*':
    print(a * b)
elif op == '/':
    print(a / b)
elif op == '**':
    print(a ** b)
elif op == '%':
    print(a % b)
else:
    print("Invalid operator")